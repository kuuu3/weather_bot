# Central Weather Administration Open Data API key.
# Apply at https://opendata.cwa.gov.tw/
CWA_API_KEY=replace_with_cwa_authorization_key

# Telegram bot token and destination chat id.
# Create a bot with BotFather, then send a message to the bot and look up chat_id.
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_telegram_chat_id

# Xizhi, New Taipei defaults.
COUNTY_NAME=新北市
LOCATION_NAME=汐止區
CWA_FORECAST_DATASET_ID=F-D0047-069
# Telegram location changes use the all-township dataset automatically.
CWA_ALL_TOWNSHIP_FORECAST_DATASET_ID=F-D0047-093

# Warning datasets are configurable because CWA warning feeds may be split by product.
CWA_WARNING_DATASET_IDS=W-C0033-001,W-C0033-002
CWA_LIGHTNING_DATASET_ID=O-A0039-001
LOCATION_LAT=25.0642
LOCATION_LON=121.6586
LIGHTNING_ALERT_RADIUS_KM=15
LIGHTNING_ALERT_MINUTES=30
CWA_RAIN_DATASET_IDS=O-A0002-001,O-A0001-001
RAIN_OBSERVATION_RADIUS_KM=8
RAIN_ACTIVE_THRESHOLD_MM=0.5
RAIN_STOP_THRESHOLD_MM=0.1
RAIN_SUSTAINED_MINUTES=60
WET_GROUND_WINDOW_MINUTES=120

# Alert tuning for LiDAR collection.
FORECAST_HOURS=12
WIND_ALERT_MPS=10.8
BEAUFORT_ALERT=6
VISIBILITY_ALERT_M=3000

# Summary and state.
SUMMARY_INTERVAL_HOURS=8
SUMMARY_INTERVAL_MINUTES=480
SUMMARY_START_TIME=
WEATHER_REPLY_COOLDOWN_SECONDS=20
STATE_FILE=state.json
REQUEST_TIMEOUT_SECONDS=20
